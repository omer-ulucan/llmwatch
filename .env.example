# ── AWS ─────────────────────────────────────────────────
# Use IAM roles in production — env vars for local dev only
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
DYNAMODB_TABLE_LOGS=llmwatch_logs
DYNAMODB_TABLE_USERS=llmwatch_users
DYNAMODB_TABLE_TRACES=llmwatch_traces

# ── Authentication ───────────────────────────────────────
# Server secret. JWT signing and provider API key encryption keys are derived
# from it. Leave empty to have a random one generated on first start and stored
# in SECRET_KEY_FILE; back that file up (losing it logs everyone out and makes
# stored provider keys unreadable). If set: at least 32 characters, e.g.
#   openssl rand -hex 32
SECRET_KEY=
SECRET_KEY_FILE=./data/secret_key
# HS256, HS384 or HS512
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── Demo Mode ────────────────────────────────────────────
# Enables login with the public demo credentials (admin@company.com / admin123).
# Off by default; the server refuses to start with DEMO_MODE=true when
# APP_ENV=production. Never expose a demo instance to the internet.
DEMO_MODE=false

# ── Rate limiting ────────────────────────────────────────
# CIDRs of reverse proxies whose X-Forwarded-For is trusted. Empty = use the
# TCP peer address. Behind nginx/a load balancer, set this to the proxy network,
# otherwise every user shares the proxy's bucket.
TRUSTED_PROXIES=
RATE_LIMIT_ENABLED=true
# memory:// is per process; use redis://host:6379 when running several workers.
RATE_LIMIT_STORAGE_URI=memory://
# Per API key / per user. slowapi syntax, e.g. "60/minute;1000/day".
RATE_LIMIT_CHAT=60/minute
RATE_LIMIT_AGENT=10/minute
# Per client IP on the chat and agent routes, across all identities.
RATE_LIMIT_PER_IP=300/minute

# ── Agent tools ──────────────────────────────────────────
# Python code execution runs model-written code as a child process of the
# backend. It is NOT a sandbox (same filesystem and network). Off by default.
ENABLE_CODE_EXECUTION=false
# The URL fetch tool blocks private, loopback and link-local addresses. Hosts
# listed here (comma-separated, exact or "*.example.com") may resolve to
# private addresses, e.g. an intranet wiki.
FETCH_ALLOWED_HOSTS=

# ── LLM Models ───────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
QWEN_BASE_URL=http://localhost:8001/v1
# Optional for self-hosted/proxy setups that do not require auth
QWEN_API_KEY=

# ── MLFlow ───────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Application ──────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000
