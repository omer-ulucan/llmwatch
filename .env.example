# LLMWatch configuration. Every variable is optional: `docker compose up` works
# with none of them. Copy to .env (next to docker-compose.yml, or in backend/
# for local development) and set only what you need.

# ── Docker Compose ───────────────────────────────────────
# Host port for the UI and API (API under /api). Read by docker-compose.yml.
LLMWATCH_PORT=3000
# Backend image extras, e.g. postgres,mlflow. Read by docker-compose.yml.
LLMWATCH_EXTRAS=postgres

# ── Database ─────────────────────────────────────────────
# SQLite by default (zero setup). For Postgres install the "postgres" extra and
# use e.g. postgresql+asyncpg://user:pass@host:5432/llmwatch
DATABASE_URL=sqlite+aiosqlite:///./data/llmwatch.db
# Apply pending migrations at startup.
AUTO_MIGRATE=true
# Log every SQL statement (debugging only).
DB_ECHO=false

# ── Authentication ───────────────────────────────────────
# Server secret. JWT signing and provider API key encryption keys are derived
# from it. Leave empty to have a random one generated on first start and stored
# in SECRET_KEY_FILE; back that file up (losing it logs everyone out and makes
# stored provider keys unreadable). If set: at least 32 characters, e.g.
#   openssl rand -hex 32
SECRET_KEY=
SECRET_KEY_FILE=./data/secret_key
# Legacy name for SECRET_KEY, used only when SECRET_KEY is unset.
JWT_SECRET_KEY=
# HS256, HS384 or HS512
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── Demo Mode ────────────────────────────────────────────
# Seeds a demo account with public credentials (DEMO_EMAIL / DEMO_PASSWORD).
# Off by default; the server refuses to start with DEMO_MODE=true when
# APP_ENV=production. Never expose a demo instance to the internet.
DEMO_MODE=false
DEMO_EMAIL=demo@llmwatch.dev
DEMO_PASSWORD=llmwatch-demo

# When false, only the very first account can sign up (instance bootstrap).
# Close registration after creating your account.
ALLOW_SIGNUP=true

# ── Rate limiting ────────────────────────────────────────
# CIDRs of reverse proxies whose X-Forwarded-For is trusted. Empty = use the
# TCP peer address. Behind nginx/a load balancer, set this to the proxy network,
# otherwise every user shares the proxy's bucket.
TRUSTED_PROXIES=
RATE_LIMIT_ENABLED=true
# memory:// is per process; use redis://host:6379 when running several workers.
RATE_LIMIT_STORAGE_URI=memory://
# Per API key / per user. slowapi syntax, e.g. "60/minute;1000/day".
RATE_LIMIT_CHAT=60/minute
RATE_LIMIT_AGENT=10/minute
# Per client IP on the chat and agent routes, across all identities.
RATE_LIMIT_PER_IP=300/minute

# ── Agent tools ──────────────────────────────────────────
# Python code execution runs model-written code as a child process of the
# backend. It is NOT a sandbox (same filesystem and network). Off by default.
ENABLE_CODE_EXECUTION=false
# The URL fetch tool blocks private, loopback and link-local addresses. Hosts
# listed here (comma-separated, exact or "*.example.com") may resolve to
# private addresses, e.g. an intranet wiki.
FETCH_ALLOWED_HOSTS=

# ── LLM providers ────────────────────────────────────────
# Providers are managed per workspace on the Models page. Anything set here is
# seeded into every workspace at startup as an "env-managed" provider (re-synced
# on restart; removing a variable disables that provider). All optional.
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
# Local servers, e.g. http://host.docker.internal:11434/v1 from Docker
OLLAMA_BASE_URL=
VLLM_BASE_URL=
VLLM_API_KEY=
# Legacy: a vLLM server for the "qwen" alias (seeded as "Qwen (vLLM)")
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=qwen3.5-35b-a3b
# Gemini's OpenAI-compatible endpoint and the model the "gemini" alias uses
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3-flash-preview
# Allow provider URLs on private/loopback addresses (local models). Set false on
# multi-tenant servers so workspace owners can't probe the internal network.
PROVIDER_ALLOW_PRIVATE_URLS=true

# ── Eval runner ──────────────────────────────────────────
# Retries for rate limits (429), timeouts and 5xx: exponential backoff with full
# jitter between EVAL_RETRY_BASE_S and EVAL_RETRY_MAX_S; Retry-After is honored.
EVAL_MAX_RETRIES=5
EVAL_RETRY_BASE_S=1.0
EVAL_RETRY_MAX_S=30.0
# Per provider, shared by all runs in the process.
EVAL_PROVIDER_CONCURRENCY=8
EVAL_PROVIDER_RPM=600
# Upper bound for the concurrency a single run may request.
EVAL_MAX_CONCURRENCY=32

# ── MLflow (optional) ────────────────────────────────────
# Mirror every LLM call to an MLflow tracking server. Needs the "mlflow"
# extra (pip install "llmwatch[mlflow]"). Empty = disabled.
MLFLOW_TRACKING_URI=

# ── Application ──────────────────────────────────────────
# development or production (production refuses DEMO_MODE=true)
APP_ENV=development
APP_VERSION=0.1.0
# Comma-separated origins allowed to call the API from a browser. Not needed when
# the UI is served by the bundled nginx (same origin).
CORS_ORIGINS=http://localhost:3000
